---
// src/pages/404.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404: Page Not Found — Kevin Stev Bayer"
  description="The requested page could not be found."
  canonicalPath="/404.html"
>
  <section class="not-found" aria-labelledby="not-found-heading">
    <p class="meta-label">HTTP 404</p>
    <h1 id="not-found-heading">Page not found</h1>
    <p>
      The URL you requested does not exist on this site. Use the links below to return to the
      projects index or curriculum vitae.
    </p>
    <div class="actions mono">
      <a href="/" class="touch-target action-btn">← Return to Home & Projects</a>
      <a href="/cv/" class="touch-target action-btn">View CV</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: var(--space-2xl);
  }
  .actions {
    margin-top: var(--space-lg);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
  .action-btn {
    border: 1px solid var(--border-strong);
    background-color: var(--bg-panel);
    color: var(--ink-primary);
    padding-inline: var(--space-md);
    font-size: var(--step--1);
  }
</style>
