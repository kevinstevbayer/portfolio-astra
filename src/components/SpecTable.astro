---
// src/components/SpecTable.astro
interface SpecRow {
  label: string;
  value: string;
}

interface Props {
  caption: string;
  specs: SpecRow[];
  hideCaptionVisually?: boolean;
}

const { caption, specs, hideCaptionVisually = false } = Astro.props;
---

<table class="spec-table">
  <caption class:list={['spec-caption', { 'sr-only': hideCaptionVisually }]}>
    {caption}
  </caption>
  <tbody>
    {
      specs.map((row) => (
        <tr>
          <th scope="row">{row.label}</th>
          <td class="spec-val">{row.value}</td>
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  .spec-caption {
    text-align: left;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-secondary);
    padding-bottom: var(--space-xs);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
