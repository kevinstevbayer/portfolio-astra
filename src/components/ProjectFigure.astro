---
// src/components/ProjectFigure.astro
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface SpecRow {
  label: string;
  value: string;
}

interface Props {
  projectId: string;
  title: string;
  media: {
    type: 'image' | 'schematic_todo';
    image_path: string;
    image_alt: string;
    todo_note?: string;
  };
  specs: SpecRow[];
  priority?: boolean;
}

const { projectId, title, media, specs, priority = false } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/projects/*.{jpg,jpeg,png,webp}'
);

let resolvedImage: ImageMetadata | null = null;
if (media.type === 'image' && media.image_path) {
  const key = '/' + media.image_path.replace(/^\//, '');
  if (images[key]) {
    const mod = await images[key]();
    resolvedImage = mod.default;
  }
}

const topSpecs = specs.slice(0, 3);
---

<figure class="project-figure">
  {
    resolvedImage ? (
      <Picture
        src={resolvedImage}
        formats={['avif', 'webp']}
        widths={[480, 800, 1200]}
        sizes="(min-width: 64rem) 720px, 100vw"
        alt={media.image_alt}
        loading={priority ? 'eager' : 'lazy'}
        decoding={priority ? 'sync' : 'async'}
        fetchpriority={priority ? 'high' : 'auto'}
        class="figure-img"
      />
    ) : (
      <div class="schematic-box" role="img" aria-label={media.image_alt}>
        <div class="schematic-header mono">
          <span>FIG // {projectId.toUpperCase()}</span>
          <span>SYSTEM BLOCK SUMMARY</span>
        </div>
        <svg
          viewBox="0 0 600 220"
          class="schematic-svg"
          aria-hidden="true"
          focusable="false"
        >
          <!-- Dimension / reference frame rules -->
          <rect x="12" y="12" width="576" height="196" fill="none" stroke="currentColor" stroke-width="1.5" />
          <line x1="12" y1="44" x2="588" y2="44" stroke="currentColor" stroke-width="1" stroke-dasharray="4 4" />
          {topSpecs.map((s, idx) => {
            const x = 28 + idx * 184;
            return (
              <g>
                <rect x={x} y="68" width="160" height="112" fill="none" stroke="currentColor" stroke-width="1.5" />
                <line x1={x} y1="100" x2={x + 160} y2="100" stroke="currentColor" stroke-width="1" />
                <text x={x + 10} y="88" font-family=" monospace" font-size="11" fill="currentColor">
                  {s.label.slice(0, 20).toUpperCase()}
                </text>
                <text x={x + 10} y="126" font-family="monospace" font-size="11" fill="currentColor">
                  {s.value.slice(0, 22)}
                </text>
                {s.value.length > 22 && (
                  <text x={x + 10} y="144" font-family="monospace" font-size="11" fill="currentColor">
                    {s.value.slice(22, 44)}
                  </text>
                )}
                {idx < topSpecs.length - 1 && (
                  <line
                    x1={x + 160}
                    y1="124"
                    x2={x + 184}
                    y2="124"
                    stroke="currentColor"
                    stroke-width="1.5"
                  />
                )}
              </g>
            );
          })}
        </svg>
      </div>
    )
  }
  <figcaption class="figure-caption mono">
    <span>Fig. {title}</span>
  </figcaption>
</figure>

<style>
  .project-figure {
    margin: 0;
    border: 1px solid var(--border-strong);
    background-color: var(--bg-panel);
  }
  .figure-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .schematic-box {
    padding: var(--space-sm);
    color: var(--ink-secondary);
    background-color: var(--bg-panel);
  }
  .schematic-header {
    display: flex;
    justify-content: space-between;
    font-size: var(--step--1);
    color: var(--ink-muted);
    margin-bottom: var(--space-2xs);
  }
  .schematic-svg {
    display: block;
    width: 100%;
    height: auto;
    color: var(--ink-primary);
  }
  .figure-caption {
    padding: var(--space-xs) var(--space-sm);
    font-size: var(--step--1);
    color: var(--ink-muted);
    border-top: 1px solid var(--border-hairline);
    background-color: var(--bg-paper);
  }
</style>
