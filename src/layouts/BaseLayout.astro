---
// src/layouts/BaseLayout.astro
import '../styles/tokens.css';
import '../styles/typography.css';
import '../styles/base.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogImage?: string;
}

const { title, description, canonicalPath = Astro.url.pathname, ogImage } = Astro.props;
const canonicalUrl = new URL(canonicalPath, Astro.site);
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl.href} />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />

    <!-- Blocking theme initializer prevents flash on load -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.setAttribute('data-theme', saved);
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="site-header" id="site-header">
      <div class="container header-inner">
        <a href="/" class="brand-link touch-target">
          <span class="brand-name">Kevin Stev Bayer</span>
        </a>

        <nav aria-label="Primary" class="primary-nav">
          <ul class="nav-list">
            <li><a href="/#projects" class="touch-target">Projects</a></li>
            <li><a href="/#skills" class="touch-target">Skills</a></li>
            <li><a href="/#experience" class="touch-target">Experience</a></li>
            <li><a href="/cv/" class="touch-target">CV</a></li>
            <li><a href="/#contact" class="touch-target">Contact</a></li>
          </ul>
          <button
            type="button"
            id="theme-toggle"
            class="theme-btn touch-target"
            aria-pressed="false"
            hidden
          >
            <span class="mono">Dark theme</span>
          </button>
        </nav>
      </div>
    </header>

    <main id="main-content" tabindex="-1" class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p class="meta-label">Kevin Stev Bayer · Chennai, Tamil Nadu, India</p>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var btn = document.getElementById('theme-toggle');

        if (!btn) return;
        function isDarkActive() {
          var attr = root.getAttribute('data-theme');
          if (attr === 'dark') return true;
          if (attr === 'light') return false;
          return window.matchMedia('(prefers-color-scheme: dark)').matches;
        }
        function syncButtonState() {
          var dark = isDarkActive();
          btn.setAttribute('aria-pressed', dark ? 'true' : 'false');
        }
        btn.removeAttribute('hidden');
        syncButtonState();

        btn.addEventListener('click', function () {
          var next = isDarkActive() ? 'light' : 'dark';
          root.setAttribute('data-theme', next);
          syncButtonState();
          try {
            localStorage.setItem('theme', next);
          } catch (_) {}
        });
      })();
    </script>

    <style>
      /*
       * Estimated single-row width of brand (~185px) + 5 nav links (~380px) + theme button (~125px)
       * + gaps (~40px) + container margins (32px) = ~762px (47.625rem).
       * Below 52rem (832px), header remains static so wrapped rows never obscure anchored content.
       */
      .site-header {
        position: static;
        top: 0;
        z-index: 50;
        background-color: var(--bg-paper);
        border-bottom: 1px solid var(--border-hairline);
      }

      @media (max-width: 51.99rem) {
        :root {
          --header-height: 0px;
        }
      }

      @media (min-width: 52rem) {
        .site-header {
          position: sticky;
        }
        :root {
          --header-height: 3.75rem;
        }
      }

      .header-inner {
        min-height: 3.75rem;
        padding-block: var(--space-2xs);
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-2xs) var(--space-sm);
      }
      .brand-link {
        text-decoration: none;
        color: var(--ink-primary);
        padding-inline: var(--space-2xs);
      }
      .brand-name {
        font-weight: 700;
        letter-spacing: -0.01em;
      }
      .primary-nav {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-2xs);
      }
      .nav-list {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        margin: 0;
        padding: 0;
        gap: var(--space-2xs);
      }
      .nav-list a {
        color: var(--ink-primary);
        font-size: var(--step--1);
        padding-inline: var(--space-xs);
      }
      .theme-btn {
        background: var(--bg-panel);
        color: var(--ink-primary);
        border: 1px solid var(--border-strong);
        cursor: pointer;
        font-size: var(--step--1);
      }
      .theme-btn[hidden] {
        display: none;
      }
      .theme-btn[aria-pressed='true'] {
        border-color: var(--accent-ui);
        background-color: var(--accent-tint);
      }
      .site-footer {
        margin-top: auto;
        padding-block: var(--space-lg);
        border-top: 1px solid var(--border-hairline);
      }
    </style>
  </body>
</html>
